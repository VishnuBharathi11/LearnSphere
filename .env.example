# Copy to .env, replace every value, and run: chmod 600 .env
COMPOSE_PROJECT_NAME=learnsphere

# At least 32 random characters. All services must share this value.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Local MySQL container (used by auth, enrollment, admin, and certificate services)
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
MYSQL_APP_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD

# MongoDB Atlas SRV URLs. Add the Oracle VM public IP to Atlas Network Access.
# Separate database names provide clear ownership; they may share one Atlas cluster.
MONGODB_COURSE_URI=mongodb+srv://USER:PASSWORD@CLUSTER/learnsphere_db?retryWrites=true&w=majority
MONGODB_PROGRESS_URI=mongodb+srv://USER:PASSWORD@CLUSTER/learnsphere_progress_db?retryWrites=true&w=majority
MONGODB_FORUM_URI=mongodb+srv://USER:PASSWORD@CLUSTER/learnsphere_forum_db?retryWrites=true&w=majority

FRONTEND_PUBLIC_URL=https://your-vercel-domain.example
BREVO_API_KEY=REPLACE_WITH_BREVO_API_KEY
BREVO_SMTP_PASSWORD=REPLACE_WITH_BREVO_SMTP_PASSWORD
RAZORPAY_KEY=REPLACE_WITH_RAZORPAY_KEY
RAZORPAY_SECRET=REPLACE_WITH_RAZORPAY_SECRET
ADMIN_SEED_PASSWORD=REPLACE_WITH_STRONG_INITIAL_ADMIN_PASSWORD
